# ── Jira ─────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=rupa@dashcare.co
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INBOX

# Custom field ids, discovered once via `wf doctor --fields`
JIRA_FIELD_SOURCE=customfield_10001
JIRA_FIELD_SOURCE_KEY=customfield_10002
JIRA_FIELD_SOURCE_URL=customfield_10003

# ── Credential + cursor store (Cloudflare KV) ────────────────────────
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# ── Ingest ───────────────────────────────────────────────────────────
LOOKBACK_HOURS=48
