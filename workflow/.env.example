# ── Jira ─────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://casedrive.atlassian.net
JIRA_EMAIL=rupa.patel@dashcaregroup.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=RUPA

# Read-only projects. The system can NEVER write outside JIRA_PROJECT_KEY.
# PP = DashCare App, DL = Data Lake
JIRA_READ_PROJECT_KEYS=PP,DL

# Custom field ids — `wf doctor` prints the correct values once the fields exist
JIRA_FIELD_SOURCE=
JIRA_FIELD_SOURCE_KEY=
JIRA_FIELD_SOURCE_URL=

# ── Credential + cursor store (Cloudflare KV) ────────────────────────
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# ── Slack (Phase 1 source + Phase 3 agent) ───────────────────────────
# A USER token (xoxp-). A bot token only sees channels the bot has joined.
# Scopes: reactions:read, channels:history, groups:history, im:history
SLACK_USER_TOKEN=
SLACK_USER_ID=
SLACK_TEAM_ID=
SLACK_TRIGGER_EMOJI=ticket

# Channels that escalate to High priority, comma separated
INCIDENT_CHANNELS=

# ── Ingest ───────────────────────────────────────────────────────────
LOOKBACK_HOURS=48
